<Window x:Class="Renamer.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Renamer.App.Views"
        Style="{StaticResource AppWindow}"
        Title="About Renamer"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel>
        <views:TitleBar Title="About Renamer" IsDialog="True" />
        <StackPanel Margin="28,12,28,24" HorizontalAlignment="Center">
            <ContentControl Template="{StaticResource AppLogo}"
                            Width="72"
                            Height="72"
                            Focusable="False"
                            IsTabStop="False" />
            <TextBlock Text="Renamer" Style="{StaticResource PageTitle}" Margin="0,14,0,2" TextAlignment="Center" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" TextAlignment="Center" />
            <TextBlock Style="{StaticResource Muted}"
                       Margin="0,14,0,0"
                       TextAlignment="Center"
                       Text="Renames movies and TV episodes for Reelhouse, Plex and Kodi." />
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextAlignment="Center">
                <Run Text="Made by" />
                <Hyperlink NavigateUri="https://github.com/grimreaper-byte"
                           RequestNavigate="OnLink"
                           ToolTip="github.com/grimreaper-byte">grimreaper-byte</Hyperlink>
                <Run Text="on GitHub" />
            </TextBlock>
            <Border Height="1" Margin="0,18" Background="{DynamicResource AppStroke}" />
            <TextBlock Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
            <Button Content="Close"
                    MinWidth="96"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
