<Window x:Class="Renamer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Renamer.App.Views"
        Style="{StaticResource AppWindow}"
        Title="Settings"
        Width="1080"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,10,28,28" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="TableCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0" Title="Settings" IsDialog="True" />

        <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource NavTabs}">

            <!-- ===== TMDB ===== -->
            <TabItem Header="TMDB" Tag="&#xE774;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="TMDB" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="The Movie Database is where titles, years and episode names come from." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="API key" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14">
                                    <Run Text="Paste your API key or read access token. You can get one free from your" />
                                    <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api" RequestNavigate="OnLink">TMDB account settings</Hyperlink><Run Text="." />
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="KeyHidden" AutomationProperties.Name="API key" PasswordChanged="OnKeyHiddenChanged" />
                                    <TextBox x:Name="KeyVisible"
                                             Style="{StaticResource CodeBox}"
                                             AutomationProperties.Name="API key"
                                             Visibility="Collapsed"
                                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="ShowKey"
                                              Grid.Column="1"
                                              Margin="14,0,0,0"
                                              Content="Show"
                                              Checked="OnShowKeyChanged"
                                              Unchecked="OnShowKeyChanged" />
                                    <Button Grid.Column="2" Margin="14,0,0,0" Content="Test key" Command="{Binding TestCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding TestResult}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding TestResult, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccess}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource AppTextFaint}" Margin="0,0,7,0" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Stored encrypted, so only your Windows account on this PC can read it." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Lookups" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                                <TextBlock Text="Language for titles" Style="{StaticResource FieldLabel}" />
                                <ComboBox Width="200"
                                          HorizontalAlignment="Left"
                                          IsEditable="True"
                                          AutomationProperties.Name="Language for titles"
                                          ItemsSource="{Binding Languages}"
                                          Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Margin="0,16,0,0" Content="Look files up as soon as they are added" IsChecked="{Binding AutoMatch}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}"
                                   Margin="0,18,0,0"
                                   Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Naming ===== -->
            <TabItem Header="Naming" Tag="&#xE8AC;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Naming" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Choose a format, or edit the templates to make your own." />

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Format" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Format"
                                          ItemsSource="{Binding PresetNames}"
                                          SelectedItem="{Binding Preset}" />
                                <TextBlock Grid.Row="1" Text="Movie file" VerticalAlignment="Center" Margin="0,14,18,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Style="{StaticResource CodeBox}" AutomationProperties.Name="Movie file" Text="{Binding MovieFile, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="Movie folder" VerticalAlignment="Center" Margin="0,8,18,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource CodeBox}" AutomationProperties.Name="Movie folder" Text="{Binding MovieFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Text="TV episode file" VerticalAlignment="Center" Margin="0,8,18,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource CodeBox}" AutomationProperties.Name="TV episode file" Text="{Binding TvFile, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="4" Text="TV folder" VerticalAlignment="Center" Margin="0,8,18,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource CodeBox}" AutomationProperties.Name="TV folder" Text="{Binding TvFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Preview" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                <Border CornerRadius="7" Padding="12,10" Background="{DynamicResource AppBackground}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PreviewMovie}" Style="{StaticResource CodeText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PreviewEpisode}" Style="{StaticResource CodeText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding PreviewMultiEpisode}" Style="{StaticResource CodeText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Tokens you can use" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Tokens}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TokenChip}" ToolTip="{Binding Meaning}">
                                                <TextBlock Text="{Binding Token}" Style="{StaticResource CodeText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12" Text="{Binding TokenHelp}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Where renamed files go" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                                <RadioButton GroupName="Destination" Content="Rename in place. The file stays in its folder and only its name changes." IsChecked="{Binding RenameInPlace}" />
                                <RadioButton GroupName="Destination" Margin="0,8,0,0" Content="Move to library. Folders are created from the templates above." IsChecked="{Binding MoveToLibrary}" />
                                <Grid Margin="27,12,0,0" IsEnabled="{Binding MoveToLibrary}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Movies" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBox Grid.Column="1" AutomationProperties.Name="Movie library folder" Text="{Binding MovieLibrary, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…" Click="OnBrowseMovies" />
                                    <TextBlock Grid.Row="1" Text="TV shows" VerticalAlignment="Center" Margin="0,8,14,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="TV library folder" Text="{Binding TvLibrary, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="8,8,0,0" Content="Browse…" Click="OnBrowseTv" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Filename regex ===== -->
            <TabItem Header="Filename regex" Tag="&#xE943;">
                <Grid Margin="28,10,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Filename regex" Style="{StaticResource PageTitle}" />
                    <TextBlock Grid.Row="1" Text="{Binding PatternHelp}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

                    <Border Grid.Row="2" Style="{StaticResource TableCard}">
                        <DataGrid ItemsSource="{Binding Patterns}"
                                  SelectedItem="{Binding SelectedPattern}"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  RowHeight="40"
                                  GotKeyboardFocus="OnGridFocus">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="On" Width="48" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="6,0,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Pattern on" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Name" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CellBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Type" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource CellCombo}"
                                                      ItemsSource="{Binding DataContext.KindOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Regex" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CellCodeBox}" Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Regex}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Glyph}"
                                                       Text="&#xE783;"
                                                       Foreground="{DynamicResource AppDanger}"
                                                       HorizontalAlignment="Center"
                                                       ToolTip="{Binding Error}"
                                                       Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Tag="&#xE710;" Content="Add" Command="{Binding AddPatternCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE74D;" Content="Remove" Margin="6,0,0,0" Command="{Binding RemovePatternCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE74A;" Content="Move up" Margin="2,0,0,0" Command="{Binding MovePatternUpCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE74B;" Content="Move down" Margin="2,0,0,0" Command="{Binding MovePatternDownCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE777;" Content="Reset to defaults" Command="{Binding ResetPatternsCommand}" />
                    </DockPanel>

                    <Border Grid.Row="4" Style="{StaticResource SettingsCard}" Margin="0,12,0,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Try a file name" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource CodeBox}"
                                     AutomationProperties.Name="Try a file name"
                                     Text="{Binding TesterInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="A file name or full path. Folders in a full path are used too." />
                            <ItemsControl Margin="0,10,0,0" Focusable="False" ItemsSource="{Binding TesterLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,24,2">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Clean-up rules ===== -->
            <TabItem Header="Clean-up rules" Tag="&#xE71C;">
                <Grid Margin="28,10,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Clean-up rules" Style="{StaticResource PageTitle}" />
                    <TextBlock Grid.Row="1" Text="{Binding RuleHelp}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

                    <Border Grid.Row="2" Style="{StaticResource TableCard}">
                        <DataGrid ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule}"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  RowHeight="40"
                                  GotKeyboardFocus="OnGridFocus">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="On" Width="48" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="6,0,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Rule on" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="When" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource CellCombo}"
                                                      ItemsSource="{Binding DataContext.StageOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Stage, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Find (regex)" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CellCodeBox}" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Find}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Replace with" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CellCodeBox}" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Note" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource CellBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Note}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Glyph}"
                                                       Text="&#xE783;"
                                                       Foreground="{DynamicResource AppDanger}"
                                                       HorizontalAlignment="Center"
                                                       ToolTip="{Binding Error}"
                                                       Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Tag="&#xE710;" Content="Add" Command="{Binding AddRuleCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE74D;" Content="Remove" Margin="6,0,0,0" Command="{Binding RemoveRuleCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE74A;" Content="Move up" Margin="2,0,0,0" Command="{Binding MoveRuleUpCommand}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE74B;" Content="Move down" Margin="2,0,0,0" Command="{Binding MoveRuleDownCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE777;" Content="Reset to defaults" Command="{Binding ResetRulesCommand}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== Files ===== -->
            <TabItem Header="Files" Tag="&#xE8B7;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Files" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Which files are listed, and what moves along with them." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Video file types" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Only these are listed when you drop a folder." Style="{StaticResource Muted}" Margin="0,4,0,10" />
                                <TextBox AutomationProperties.Name="Video file types" Text="{Binding VideoExtensions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Subtitles" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                <CheckBox Content="Rename subtitle files along with their video" IsChecked="{Binding RenameSidecars}" />
                                <TextBlock Text="Language tags are kept, so Old.en.srt becomes New.en.srt." Style="{StaticResource Muted}" Margin="27,4,0,10" />
                                <TextBox Margin="27,0,0,0" AutomationProperties.Name="Subtitle file types" Text="{Binding SidecarExtensions, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RenameSidecars}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Skip pattern (regex)" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Files whose name or folder matches are left out, such as samples and trailers. Leave empty to skip nothing."
                                           Style="{StaticResource Muted}"
                                           Margin="0,4,0,10" />
                                <TextBox Style="{StaticResource CodeBox}" AutomationProperties.Name="Skip pattern" Text="{Binding IgnorePattern, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding IgnoreError}"
                                           Style="{StaticResource ErrorText}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding IgnoreError, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Appearance ===== -->
            <TabItem Header="Appearance" Tag="&#xE790;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Choose how Renamer looks." />

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                                <RadioButton GroupName="Theme" Content="Match Windows" IsChecked="{Binding IsSystemTheme}" />
                                <RadioButton GroupName="Theme" Margin="0,8,0,0" Content="Light" IsChecked="{Binding IsLightTheme}" />
                                <RadioButton GroupName="Theme" Margin="0,8,0,0" Content="Dark" IsChecked="{Binding IsDarkTheme}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="20,12"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppStroke}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ValidationError}"
                           Style="{StaticResource ErrorText}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           MaxHeight="40"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ValidationError}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" MinWidth="88" MinHeight="36" IsCancel="True" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Save"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
